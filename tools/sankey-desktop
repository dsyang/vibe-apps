      groceries: { color: "#d48a6a" },
      japan: { color: "#5b8deb" },
      vanguard: { color: "#7fc49b" },
      dining: { color: "#e0a545" }
    }
  };

  document.getElementById('data-editor').value = JSON.stringify(exampleData, null, 2);
  document.getElementById('style-editor').value = JSON.stringify(exampleStyle, null, 2);
  nodeOffsets = {};
  titleDragOffset = { x: 0, y: 0 };
  renderDiagram();
  setStatus('Example loaded');
}

// ─── Pan with middle-click / scroll ───────────────────────────────
const canvasArea = document.getElementById('canvas-area');
canvasArea.addEventListener('wheel', (e) => {
  e.preventDefault();
  if (e.ctrlKey || e.metaKey) {
    // Zoom
    const delta = e.deltaY > 0 ? 0.9 : 1.1;
    zoomLevel = Math.max(0.3, Math.min(5, zoomLevel * delta));
    applyZoom();
  } else {
    // Pan
    const svg = document.getElementById('sankey-svg');
    const vb = svg.getAttribute('viewBox').split(' ').map(Number);
    vb[0] += e.deltaX * 0.5 / zoomLevel;
    vb[1] += e.deltaY * 0.5 / zoomLevel;
    svg.setAttribute('viewBox', vb.join(' '));
  }
}, { passive: false });

// ─── Initialize ───────────────────────────────────────────────────
loadExample();
</script>
