<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Interactive Sankey diagram builder and exporter optimized for desktop" />
<title>Sankey Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #0f1117;
  --bg-panel: #181a22;
  --bg-panel-hover: #1e2130;
  --bg-input: #12131a;
  --border: #2a2d3a;
  --border-focus: #5b8deb;
  --text: #e2e4ea;
  --text-dim: #8b8fa3;
  --text-muted: #5a5e72;
  --accent: #5b8deb;
  --accent-hover: #7ba4f5;
  --canvas-bg: #fafbfd;
  --danger: #e05555;
  --success: #4caf80;
  --warning: #e0a545;
  --tab-active: #5b8deb;
  --scrollbar-track: #12131a;
  --scrollbar-thumb: #2a2d3a;
}

html, body {
  height: 100%;
  font-family: 'DM Sans', sans-serif;
  background: var(--bg);
  color: var(--text);
  overflow: hidden;
}

/* Layout */
.app {
  display: grid;
  grid-template-columns: 380px 1fr;
  grid-template-rows: 48px 1fr;
  height: 100vh;
}

/* Top Bar */
.topbar {
  grid-column: 1 / -1;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 16px;
  z-index: 10;
}

.topbar-brand {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 600;
  font-size: 14px;
  letter-spacing: -0.5px;
  color: var(--accent);
  display: flex;
  align-items: center;
  gap: 8px;
}

.topbar-brand svg { opacity: 0.9; }

.topbar-actions {
  margin-left: auto;
  display: flex;
  gap: 8px;
}

.btn {
  font-family: 'DM Sans', sans-serif;
  font-size: 12px;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--bg-panel);
  color: var(--text);
  cursor: pointer;
  transition: all 0.15s;
  display: flex;
  align-items: center;
  gap: 6px;
}

.btn:hover { background: var(--bg-panel-hover); border-color: var(--text-muted); }
.btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
.btn-danger { color: var(--danger); }
.btn-danger:hover { background: rgba(224,85,85,0.1); border-color: var(--danger); }

/* Sidebar */
.sidebar {
  background: var(--bg-panel);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sidebar-tabs {
  display: flex;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.sidebar-tab {
  flex: 1;
  padding: 10px 8px;
  font-size: 12px;
  font-weight: 600;
  text-align: center;
  cursor: pointer;
  color: var(--text-dim);
  border-bottom: 2px solid transparent;
  transition: all 0.15s;
  background: none;
  border-top: none;
  border-left: none;
  border-right: none;
  font-family: 'DM Sans', sans-serif;
}

.sidebar-tab:hover { color: var(--text); background: var(--bg-panel-hover); }
.sidebar-tab.active { color: var(--accent); border-bottom-color: var(--accent); }

.sidebar-content {
  flex: 1;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
}

.sidebar-content::-webkit-scrollbar { width: 6px; }
.sidebar-content::-webkit-scrollbar-track { background: var(--scrollbar-track); }
.sidebar-content::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 3px; }

.tab-panel { display: none; padding: 16px; }
.tab-panel.active { display: block; }

/* Form elements */
.field { margin-bottom: 14px; }
.field-label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-dim);
  margin-bottom: 5px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-family: 'IBM Plex Mono', monospace;
}

.field-hint {
  font-size: 11px;
  color: var(--text-muted);
  margin-bottom: 6px;
  line-height: 1.4;
}

textarea, input[type="text"], input[type="number"], select {
  width: 100%;
  background: var(--bg-input);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 6px;
  padding: 8px 10px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  transition: border-color 0.15s;
  outline: none;
}

textarea:focus, input:focus, select:focus { border-color: var(--border-focus); }

textarea {
  resize: vertical;
  min-height: 120px;
  line-height: 1.5;
}

.editor-area {
  min-height: 280px;
  font-size: 11px;
}

/* Mini toolbar for editors */
.editor-toolbar {
  display: flex;
  gap: 6px;
  margin-bottom: 8px;
}

.section-header {
  font-size: 13px;
  font-weight: 700;
  margin: 18px 0 10px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--border);
  color: var(--text);
}

.section-header:first-child { margin-top: 0; }

/* Canvas area */
.canvas-area {
  background: var(--canvas-bg);
  position: relative;
  overflow: hidden;
}

.canvas-area svg {
  width: 100%;
  height: 100%;
  display: block;
}

/* Node styling in SVG */
.sankey-node { cursor: grab; }
.sankey-node:active { cursor: grabbing; }
.sankey-node rect { transition: opacity 0.15s; }
.sankey-node:hover rect { opacity: 0.85; }
.sankey-link { transition: opacity 0.15s; }
.sankey-link:hover { opacity: 0.55 !important; }

/* Tooltip */
.tooltip {
  position: fixed;
  background: var(--bg-panel);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 12px;
  pointer-events: none;
  z-index: 100;
  opacity: 0;
  transition: opacity 0.12s;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  max-width: 260px;
  font-family: 'DM Sans', sans-serif;
}

.tooltip.visible { opacity: 1; }
.tooltip-title { font-weight: 700; margin-bottom: 4px; }
.tooltip-value { color: var(--accent); font-family: 'IBM Plex Mono', monospace; font-weight: 600; }
.tooltip-pct { color: var(--text-dim); font-size: 11px; }

/* Status bar */
.status-bar {
  position: absolute;
  bottom: 12px;
  left: 12px;
  display: flex;
  gap: 8px;
  align-items: center;
  font-size: 11px;
  color: #6b7080;
  font-family: 'IBM Plex Mono', monospace;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(6px);
  padding: 4px 10px;
  border-radius: 6px;
  border: 1px solid #e2e5ec;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--success);
}

.status-dot.error { background: var(--danger); }

/* Canvas controls */
.canvas-controls {
  position: absolute;
  top: 12px;
  right: 12px;
  display: flex;
  gap: 6px;
}

.canvas-btn {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  border: 1px solid #d8dbe5;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(6px);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #555;
  font-size: 14px;
  transition: all 0.15s;
}

.canvas-btn:hover { background: #fff; border-color: #aab; color: #222; }

/* Modal */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 200;
  align-items: center;
  justify-content: center;
}

.modal-overlay.visible { display: flex; }

.modal {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px;
  width: 600px;
  max-height: 80vh;
  overflow-y: auto;
  color: var(--text);
}

.modal h2 {
  font-size: 16px;
  margin-bottom: 16px;
  font-weight: 700;
}

.modal-actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  margin-top: 20px;
}

/* Inline color swatch */
.color-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
  font-size: 12px;
  font-family: 'IBM Plex Mono', monospace;
}

.color-swatch {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  border: 1px solid rgba(255,255,255,0.1);
  flex-shrink: 0;
}

/* Drag hint */
.drag-hint {
  position: absolute;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(6px);
  padding: 5px 14px;
  border-radius: 6px;
  border: 1px solid #d8dbe5;
  font-size: 11px;
  color: #6b7080;
  font-family: 'IBM Plex Mono', monospace;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
}

.drag-hint.visible { opacity: 1; }

/* Error display */
.parse-error {
  background: rgba(224,85,85,0.1);
  border: 1px solid rgba(224,85,85,0.3);
  border-radius: 6px;
  padding: 8px 10px;
  font-size: 11px;
  color: var(--danger);
  margin-top: 8px;
  font-family: 'IBM Plex Mono', monospace;
  white-space: pre-wrap;
  display: none;
}

.parse-error.visible { display: block; }
</style>
</head>
<body>

<div class="app">
  <!-- Top Bar -->
  <div class="topbar">
    <div class="topbar-brand">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <rect x="1" y="3" width="4" height="14" rx="1" fill="#5b8deb"/>
        <rect x="8" y="1" width="4" height="18" rx="1" fill="#5b8deb" opacity="0.7"/>
        <rect x="15" y="5" width="4" height="10" rx="1" fill="#5b8deb" opacity="0.5"/>
        <path d="M5 7 L8 4" stroke="#5b8deb" stroke-width="1.2" opacity="0.4"/>
        <path d="M5 13 L8 16" stroke="#5b8deb" stroke-width="1.2" opacity="0.4"/>
        <path d="M12 6 L15 8" stroke="#5b8deb" stroke-width="1.2" opacity="0.4"/>
        <path d="M12 14 L15 12" stroke="#5b8deb" stroke-width="1.2" opacity="0.4"/>
      </svg>
      Sankey Studio
    </div>
    <div class="topbar-actions">
      <button class="btn" onclick="loadExample()">Load Example</button>
      <button class="btn" onclick="showExportModal()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
        Export
      </button>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="sidebar">
    <div class="sidebar-tabs">
      <button class="sidebar-tab active" data-tab="data">Data</button>
      <button class="sidebar-tab" data-tab="style">Style</button>
      <button class="sidebar-tab" data-tab="help">Format</button>
    </div>
    <div class="sidebar-content">
      <!-- DATA TAB -->
      <div class="tab-panel active" id="tab-data">
        <div class="section-header">Diagram Data</div>
        <div class="field">
          <label class="field-label">Data (JSON)</label>
          <div class="field-hint">Nodes and links defining the flow. See Format tab for spec.</div>
          <textarea id="data-editor" class="editor-area" spellcheck="false"></textarea>
          <div class="parse-error" id="data-error"></div>
        </div>
        <div class="editor-toolbar">
          <button class="btn" onclick="formatEditor('data-editor')">Format JSON</button>
          <button class="btn btn-primary" onclick="renderDiagram()">Render</button>
        </div>
      </div>

      <!-- STYLE TAB -->
      <div class="tab-panel" id="tab-style">
        <div class="section-header">Diagram Descriptor</div>
        <div class="field">
          <label class="field-label">Style Descriptor (JSON)</label>
          <div class="field-hint">Colors, column positions, sizing. See Format tab for spec.</div>
          <textarea id="style-editor" class="editor-area" spellcheck="false"></textarea>
          <div class="parse-error" id="style-error"></div>
        </div>
        <div class="editor-toolbar">
          <button class="btn" onclick="formatEditor('style-editor')">Format JSON</button>
          <button class="btn btn-primary" onclick="renderDiagram()">Apply</button>
        </div>

        <div class="section-header">Node Colors</div>
        <div id="color-preview"></div>
      </div>

      <!-- HELP TAB -->
      <div class="tab-panel" id="tab-help">
        <div class="section-header">Data Format</div>
        <div style="font-size:12px; line-height:1.6; color:var(--text-dim);">
          <p style="margin-bottom:10px;">The <strong style="color:var(--text)">Data</strong> object defines nodes and links:</p>
<pre style="background:var(--bg-input);padding:10px;border-radius:6px;font-size:11px;overflow-x:auto;color:var(--text);margin-bottom:14px;font-family:'IBM Plex Mono',monospace;white-space:pre-wrap;">{
  "nodes": [
    {
      "id": "w2",
      "label": "W2 Paycheck",
      "column": -1
    },
    {
      "id": "income",
      "label": "Income",
      "column": 0
    },
    {
      "id": "fixed",
      "label": "Fixed Expenses",
      "column": 1
    }
  ],
  "links": [
    {
      "source": "w2",
      "target": "income",
      "value": 91820
    },
    {
      "source": "income",
      "target": "fixed",
      "value": 120063.86
    }
  ]
}</pre>

          <p style="margin-bottom:6px;"><strong style="color:var(--text)">Nodes</strong></p>
          <p style="margin-bottom:10px;"><code style="color:var(--accent)">id</code> — unique identifier<br>
          <code style="color:var(--accent)">label</code> — display name<br>
          <code style="color:var(--accent)">column</code> — integer column position. <strong style="color:var(--text)">Column 0 is the anchor</strong> (centered on reset). Use negative columns (-1, -2…) for sources flowing in, positive (1, 2…) for outflows.</p>

          <p style="margin-bottom:6px;"><strong style="color:var(--text)">Links</strong></p>
          <p style="margin-bottom:10px;"><code style="color:var(--accent)">source</code> — source node id<br>
          <code style="color:var(--accent)">target</code> — target node id<br>
          <code style="color:var(--accent)">value</code> — numeric flow value<br>
          <code style="color:var(--accent)">label</code> — (optional) display label on hover</p>
        </div>

        <div class="section-header">Style Descriptor Format</div>
        <div style="font-size:12px; line-height:1.6; color:var(--text-dim);">
          <p style="margin-bottom:10px;">Separate from data. Controls appearance:</p>
<pre style="background:var(--bg-input);padding:10px;border-radius:6px;font-size:11px;overflow-x:auto;color:var(--text);margin-bottom:14px;font-family:'IBM Plex Mono',monospace;white-space:pre-wrap;">{
  "title": { 
    "text": "Cash Flow",
    "fontSize": 22 
  },
  "canvas": {
    "width": 1200,
    "height": 800,
    "padding": [40, 40, 40, 40],
    "background": "#fafbfd"
  },
  "columns": {
    "positions": {
      "-1": 0.05,
      "0": 0.35,
      "1": 0.6,
      "2": 0.82
    }
  },
  "nodeDefaults": {
    "width": 18,
    "padding": 14,
    "labelFontSize": 11,
    "valueFontSize": 10
  },
  "linkDefaults": {
    "opacity": 0.35,
    "hoverOpacity": 0.55
  },
  "nodeStyles": {
    "income": { "color": "#4caf80" },
    "fixed": { "color": "#e05555" }
  }
}</pre>

          <p style="margin-bottom:6px;"><strong style="color:var(--text)">columns.positions</strong> — object keyed by column number</p>
          <p style="margin-bottom:10px;">Values are 0–1 fractions of the inner width. Negative keys are fine: <code style="color:var(--accent)">"-1": 0.05</code>. If omitted, columns are auto-spaced evenly.</p>

          <p style="margin-bottom:6px;"><strong style="color:var(--text)">nodeStyles</strong> — keyed by node id</p>
          <p><code style="color:var(--accent)">color</code> — fill color for node &amp; links from it<br>
          <code style="color:var(--accent)">labelColor</code> — (optional) text color<br>
          <code style="color:var(--accent)">width</code> — (optional) override node bar width</p>

          <p style="margin-top:14px;"><strong style="color:var(--text)">Interaction</strong><br>
          Drag nodes vertically to reposition them. The updated positions persist and are included in exports.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Canvas -->
  <div class="canvas-area" id="canvas-area">
    <svg id="sankey-svg" xmlns="http://www.w3.org/2000/svg"></svg>
    <div class="drag-hint" id="drag-hint">Drag nodes or title to reposition</div>
    <div class="canvas-controls">
      <button class="canvas-btn" onclick="zoomIn()" title="Zoom in">+</button>
      <button class="canvas-btn" onclick="zoomOut()" title="Zoom out">−</button>
      <button class="canvas-btn" onclick="zoomReset()" title="Fit to view">⊡</button>
    </div>
    <div class="status-bar">
      <div class="status-dot" id="status-dot"></div>
      <span id="status-text">Ready</span>
    </div>
  </div>
</div>

<!-- Tooltip -->
<div class="tooltip" id="tooltip">
  <div class="tooltip-title" id="tooltip-title"></div>
  <div class="tooltip-value" id="tooltip-value"></div>
  <div class="tooltip-pct" id="tooltip-pct"></div>
</div>

<!-- Export Modal -->
<div class="modal-overlay" id="export-modal">
  <div class="modal">
    <h2>Export Diagram</h2>
    <div class="field">
      <label class="field-label">Format</label>
      <select id="export-format">
        <option value="svg">SVG (vector)</option>
        <option value="png">PNG (raster image)</option>
      </select>
    </div>
    <div class="field">
      <label class="field-label">Scale (PNG only)</label>
      <select id="export-scale">
        <option value="1">1x</option>
        <option value="2" selected>2x</option>
        <option value="3">3x</option>
      </select>
    </div>
    <div class="field">
      <label class="field-label">Include data &amp; descriptor as text</label>
      <select id="export-include-data">
        <option value="yes">Yes — embed as comment/metadata</option>
        <option value="no">No</option>
      </select>
    </div>
    <div class="modal-actions">
      <button class="btn" onclick="closeExportModal()">Cancel</button>
      <button class="btn btn-primary" onclick="doExport()">Download</button>
    </div>
  </div>
</div>

<script>
// ─── State ────────────────────────────────────────────────────────
let currentData = null;
let currentStyle = null;
let computedNodes = [];
let computedLinks = [];
let dragState = null;
let viewBox = { x: 0, y: 0, w: 1200, h: 800 };
let zoomLevel = 1;
// nodeOffsets stores per-node y-offset from user dragging
let nodeOffsets = {};
// Title drag offset
let titleDragOffset = { x: 0, y: 0 };
// Track column 0 position for centering on reset
let lastCol0X = null;

// ─── Tab switching ────────────────────────────────────────────────
document.querySelectorAll('.sidebar-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.sidebar-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
  });
});

// ─── Helpers ──────────────────────────────────────────────────────
function formatCurrency(v) {
  return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function formatEditor(id) {
  const el = document.getElementById(id);
  try {
    const obj = JSON.parse(el.value);
    el.value = JSON.stringify(obj, null, 2);
    hideError(id === 'data-editor' ? 'data-error' : 'style-error');
  } catch(e) {
    showError(id === 'data-editor' ? 'data-error' : 'style-error', e.message);
  }
}

function showError(id, msg) {
  const el = document.getElementById(id);
  el.textContent = msg;
  el.classList.add('visible');
}

function hideError(id) {
  document.getElementById(id).classList.remove('visible');
}

function setStatus(text, ok = true) {
  document.getElementById('status-text').textContent = text;
  document.getElementById('status-dot').className = 'status-dot' + (ok ? '' : ' error');
}

function getStyleProp(path, fallback) {
  if (!currentStyle) return fallback;
  const parts = path.split('.');
  let v = currentStyle;
  for (const p of parts) {
    if (v == null) return fallback;
    v = v[p];
  }
  return v ?? fallback;
}

// ─── Sankey Layout Engine ─────────────────────────────────────────
function computeLayout(data, style) {
  const canvasW = getStyleProp('canvas.width', 1200);
  const canvasH = getStyleProp('canvas.height', 800);
  const pad = getStyleProp('canvas.padding', [50, 50, 50, 50]);
  const nodeWidth = getStyleProp('nodeDefaults.width', 18);
  const nodePadding = getStyleProp('nodeDefaults.padding', 14);

  const innerLeft = pad[3];
  const innerRight = canvasW - pad[1];
  const innerTop = pad[0];
  const innerBottom = canvasH - pad[2];
  const innerW = innerRight - innerLeft;
  const innerH = innerBottom - innerTop;

  // Title offset
  const titleText = getStyleProp('title.text', '');
  const titleOffset = titleText ? 36 : 0;
  const drawTop = innerTop + titleOffset;
  const drawH = innerH - titleOffset;

  // Determine columns
  const columns = {};
  data.nodes.forEach(n => {
    if (!columns[n.column]) columns[n.column] = [];
    columns[n.column].push(n.id);
  });
  const colIndices = Object.keys(columns).map(Number).sort((a, b) => a - b);
  const colPositions = getStyleProp('columns.positions', null);

  // X positions for each column — positions is now an object keyed by column number
  const colX = {};
  colIndices.forEach((ci, i) => {
    if (colPositions && colPositions[String(ci)] != null) {
      colX[ci] = innerLeft + colPositions[String(ci)] * innerW;
    } else {
      // Auto-space evenly
      colX[ci] = innerLeft + (i / Math.max(colIndices.length - 1, 1)) * (innerW - nodeWidth);
    }
  });

  // Track column 0's x for centering
  const col0X = colX[0] ?? (innerLeft + innerW / 2);

  // Build node map
  const nodeMap = {};
  data.nodes.forEach(n => {
    nodeMap[n.id] = {
      ...n,
      sourceLinks: [],
      targetLinks: [],
      value: 0,
      x: colX[n.column],
      y: 0,
      height: 0
    };
  });

  // Build links
  const links = data.links.map(l => ({
    ...l,
    sourceNode: nodeMap[l.source],
    targetNode: nodeMap[l.target]
  }));

  links.forEach(l => {
    if (l.sourceNode) l.sourceNode.sourceLinks.push(l);
    if (l.targetNode) l.targetNode.targetLinks.push(l);
  });

  // Compute node values (max of in/out)
  Object.values(nodeMap).forEach(n => {
    const outVal = n.sourceLinks.reduce((s, l) => s + l.value, 0);
    const inVal = n.targetLinks.reduce((s, l) => s + l.value, 0);
    n.value = Math.max(outVal, inVal);
  });

  // Scale: figure out the tallest column to determine value→pixel scale
  let maxColValue = 0;
  colIndices.forEach(ci => {
    const ids = columns[ci];
    const totalValue = ids.reduce((s, id) => s + nodeMap[id].value, 0);
    const totalPadding = (ids.length - 1) * nodePadding;
    maxColValue = Math.max(maxColValue, totalValue / (drawH - totalPadding));
  });

  const scale = maxColValue > 0 ? 1 / maxColValue : 1;

  // Position nodes in each column — vertically centered
  colIndices.forEach(ci => {
    const ids = columns[ci];
    // Sort by value descending for nice default layout
    ids.sort((a, b) => nodeMap[b].value - nodeMap[a].value);

    // Compute total column height
    let colHeight = 0;
    ids.forEach(id => {
      nodeMap[id].height = Math.max(nodeMap[id].value * scale, 4);
      colHeight += nodeMap[id].height;
    });
    colHeight += (ids.length - 1) * nodePadding;

    // Center vertically in the draw area
    let y = drawTop + (drawH - colHeight) / 2;

    ids.forEach(id => {
      const n = nodeMap[id];
      n.y = y;
      // Apply user drag offset
      if (nodeOffsets[id] != null) {
        n.y += nodeOffsets[id];
      }
      y += n.height + nodePadding;
    });
  });

  // Compute link paths (y positions on source/target side)
  colIndices.forEach(ci => {
    const ids = columns[ci];
    ids.forEach(id => {
      const n = nodeMap[id];
      let sy = n.y;
      // Sort source links to match target ordering (top to bottom)
      n.sourceLinks.sort((a, b) => {
        const ay = a.targetNode ? a.targetNode.y : 0;
        const by = b.targetNode ? b.targetNode.y : 0;
        return ay - by;
      });
      n.sourceLinks.forEach(l => {
        l.sy = sy;
        l.sh = l.value * scale;
        sy += l.sh;
      });

      let ty = n.y;
      n.targetLinks.sort((a, b) => {
        const ay = a.sourceNode ? a.sourceNode.y : 0;
        const by = b.sourceNode ? b.sourceNode.y : 0;
        return ay - by;
      });
      n.targetLinks.forEach(l => {
        l.ty = ty;
        l.th = l.value * scale;
        ty += l.th;
      });
    });
  });

  return {
    nodes: Object.values(nodeMap),
    links,
    canvasW,
    canvasH,
    nodeWidth,
    titleText,
    titleOffset,
    drawTop,
    pad,
    innerW,
    innerH,
    col0X
  };
}

// ─── SVG Rendering ────────────────────────────────────────────────
function renderDiagram() {
  hideError('data-error');
  hideError('style-error');

  // Parse data
  let data, style;
  try {
    data = JSON.parse(document.getElementById('data-editor').value);
    currentData = data;
  } catch(e) {
    showError('data-error', 'JSON parse error: ' + e.message);
    setStatus('Data error', false);
    return;
  }

  try {
    style = JSON.parse(document.getElementById('style-editor').value);
    currentStyle = style;
  } catch(e) {
    showError('style-error', 'JSON parse error: ' + e.message);
    setStatus('Style error', false);
    return;
  }

  // Validate
  if (!data.nodes || !data.links) {
    showError('data-error', 'Data must have "nodes" and "links" arrays.');
    setStatus('Invalid data', false);
    return;
  }

  const layout = computeLayout(data, style);
  const { nodes, links, canvasW, canvasH, nodeWidth, titleText, pad, col0X } = layout;

  computedNodes = nodes;
  computedLinks = links;
  lastCol0X = col0X;

  zoomLevel = 1;

  const svg = document.getElementById('sankey-svg');
  // Center viewport on column 0
  const vbX = col0X - canvasW / 2;
  const vbY = 0;
  svg.setAttribute('viewBox', `${vbX} ${vbY} ${canvasW} ${canvasH}`);
  svg.innerHTML = '';

  // Background — oversized to cover any pan/zoom position
  const bg = getStyleProp('canvas.background', '#fafbfd');
  const bgRect = svgEl('rect', { x: -5000, y: -5000, width: 15000, height: 15000, fill: bg });
  svg.appendChild(bgRect);

  // Title — draggable
  if (titleText) {
    const titleG = svgEl('g', { class: 'sankey-node', 'data-id': '__title__', style: 'cursor:grab' });
    const titleX = pad[3] + titleDragOffset.x;
    const titleY = pad[0] + 20 + titleDragOffset.y;
    const titleEl = svgEl('text', {
      x: titleX,
      y: titleY,
      'font-family': "'DM Sans', sans-serif",
      'font-size': getStyleProp('title.fontSize', 22),
      'font-weight': '700',
      fill: '#1a1c24'
    });
    titleEl.textContent = titleText;
    titleG.appendChild(titleEl);
    titleG.addEventListener('mousedown', (e) => startTitleDrag(e, titleX, titleY));
    svg.appendChild(titleG);
  }

  // Defs for gradients
  const defs = svgEl('defs', {});
  svg.appendChild(defs);

  // Links
  const linkGroup = svgEl('g', { class: 'sankey-links' });
  svg.appendChild(linkGroup);

  const defaultLinkOpacity = getStyleProp('linkDefaults.opacity', 0.35);

  links.forEach((l, i) => {
    const sn = l.sourceNode;
    const tn = l.targetNode;
    if (!sn || !tn) return;

    const x0 = sn.x + nodeWidth;
    const x1 = tn.x;
    const midX = (x0 + x1) / 2;

    // Source color
    const sc = getNodeColor(sn.id);
    const tc = getNodeColor(tn.id);

    // Create gradient
    const gradId = `lg-${i}`;
    const grad = svgEl('linearGradient', { id: gradId, gradientUnits: 'userSpaceOnUse', x1: x0, x2: x1 });
    grad.appendChild(svgEl('stop', { offset: '0%', 'stop-color': sc, 'stop-opacity': defaultLinkOpacity }));
    grad.appendChild(svgEl('stop', { offset: '100%', 'stop-color': tc, 'stop-opacity': defaultLinkOpacity }));
    defs.appendChild(grad);

    const y0top = l.sy;
    const y0bot = l.sy + l.sh;
    const y1top = l.ty;
    const y1bot = l.ty + l.th;

    const d = `M${x0},${y0top} C${midX},${y0top} ${midX},${y1top} ${x1},${y1top} L${x1},${y1bot} C${midX},${y1bot} ${midX},${y0bot} ${x0},${y0bot} Z`;

    const path = svgEl('path', {
      d,
      fill: `url(#${gradId})`,
      class: 'sankey-link',
      'data-source': sn.id,
      'data-target': tn.id,
      'data-value': l.value
    });

    path.addEventListener('mouseenter', (e) => showTooltip(e, `${sn.label} → ${tn.label}`, l.value, l.label || ''));
    path.addEventListener('mousemove', moveTooltip);
    path.addEventListener('mouseleave', hideTooltip);

    linkGroup.appendChild(path);
  });

  // Nodes
  const nodeGroup = svgEl('g', { class: 'sankey-nodes' });
  svg.appendChild(nodeGroup);

  const labelFontSize = getStyleProp('nodeDefaults.labelFontSize', 11);
  const valueFontSize = getStyleProp('nodeDefaults.valueFontSize', 10);

  // Total value for percentage calc
  const rootNodes = nodes.filter(n => n.targetLinks.length === 0);
  const totalValue = rootNodes.reduce((s, n) => s + n.value, 0);

  // Column range for label placement
  const minCol = Math.min(...nodes.map(n => n.column));

  nodes.forEach(n => {
    const color = getNodeColor(n.id);
    const g = svgEl('g', { class: 'sankey-node', 'data-id': n.id });

    const rect = svgEl('rect', {
      x: n.x,
      y: n.y,
      width: getNodeWidth(n.id),
      height: n.height,
      rx: 3,
      fill: color
    });
    g.appendChild(rect);

    // Label — leftmost column: labels go left; all others: right
    const isRightSide = n.column > minCol;
    const labelX = isRightSide ? n.x + getNodeWidth(n.id) + 8 : n.x - 8;
    const anchor = isRightSide ? 'start' : 'end';

    const label = svgEl('text', {
      x: labelX,
      y: n.y + Math.min(n.height / 2, 8),
      'font-family': "'DM Sans', sans-serif",
      'font-size': labelFontSize,
      'font-weight': '600',
      fill: '#2a2d3a',
      'text-anchor': anchor,
      'dominant-baseline': 'middle'
    });
    label.textContent = n.label;
    g.appendChild(label);

    // Value text
    const valLabel = svgEl('text', {
      x: labelX,
      y: n.y + Math.min(n.height / 2, 8) + labelFontSize + 2,
      'font-family': "'IBM Plex Mono', monospace",
      'font-size': valueFontSize,
      fill: '#6b7080',
      'text-anchor': anchor,
      'dominant-baseline': 'middle'
    });
    const pct = totalValue > 0 ? ((n.value / totalValue) * 100).toFixed(1) : 0;
    valLabel.textContent = `${formatCurrency(n.value)} (${pct}%)`;
    g.appendChild(valLabel);

    // Hover + tooltip
    g.addEventListener('mouseenter', (e) => showTooltip(e, n.label, n.value, `${pct}% of total`));
    g.addEventListener('mousemove', moveTooltip);
    g.addEventListener('mouseleave', hideTooltip);

    // Drag
    g.addEventListener('mousedown', (e) => startDrag(e, n));

    nodeGroup.appendChild(g);
  });

  updateColorPreview();
  setStatus(`${nodes.length} nodes, ${links.length} links`);

  // Show drag hint briefly
  const hint = document.getElementById('drag-hint');
  hint.classList.add('visible');
  setTimeout(() => hint.classList.remove('visible'), 3000);
}

function getNodeColor(id) {
  const style = getStyleProp(`nodeStyles.${id}`, null);
  if (style && style.color) return style.color;
  // Generate a deterministic color from the id
  const colors = ['#5b8deb', '#e05555', '#4caf80', '#e0a545', '#9b59b6', '#1abc9c', '#e67e22', '#3498db', '#e74c3c', '#2ecc71', '#f39c12', '#8e44ad'];
  let hash = 0;
  for (let i = 0; i < id.length; i++) hash = ((hash << 5) - hash) + id.charCodeAt(i);
  return colors[Math.abs(hash) % colors.length];
}

function getNodeWidth(id) {
  const style = getStyleProp(`nodeStyles.${id}`, null);
  if (style && style.width) return style.width;
  return getStyleProp('nodeDefaults.width', 18);
}

function svgEl(tag, attrs) {
  const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
  for (const [k, v] of Object.entries(attrs)) {
    el.setAttribute(k, v);
  }
  return el;
}

// ─── Tooltip ──────────────────────────────────────────────────────
function showTooltip(e, title, value, extra) {
  const tt = document.getElementById('tooltip');
  document.getElementById('tooltip-title').textContent = title;
  document.getElementById('tooltip-value').textContent = formatCurrency(value);
  document.getElementById('tooltip-pct').textContent = extra;
  tt.classList.add('visible');
  moveTooltip(e);
}

function moveTooltip(e) {
  const tt = document.getElementById('tooltip');
  tt.style.left = (e.clientX + 14) + 'px';
  tt.style.top = (e.clientY - 10) + 'px';
}

function hideTooltip() {
  document.getElementById('tooltip').classList.remove('visible');
}

// ─── Dragging ─────────────────────────────────────────────────────
function startDrag(e, node) {
  e.preventDefault();
  const svg = document.getElementById('sankey-svg');
  const pt = svg.createSVGPoint();
  pt.x = e.clientX;
  pt.y = e.clientY;
  const svgP = pt.matrixTransform(svg.getScreenCTM().inverse());

  dragState = {
    nodeId: node.id,
    startMouseY: svgP.y,
    startOffset: nodeOffsets[node.id] || 0
  };

  document.addEventListener('mousemove', onDrag);
  document.addEventListener('mouseup', endDrag);
}

function onDrag(e) {
  if (!dragState) return;
  const svg = document.getElementById('sankey-svg');
  const pt = svg.createSVGPoint();
  pt.x = e.clientX;
  pt.y = e.clientY;
  const svgP = pt.matrixTransform(svg.getScreenCTM().inverse());

  const dy = svgP.y - dragState.startMouseY;
  nodeOffsets[dragState.nodeId] = dragState.startOffset + dy;
  renderDiagram();
}

function endDrag() {
  dragState = null;
  document.removeEventListener('mousemove', onDrag);
  document.removeEventListener('mouseup', endDrag);
}

// ─── Title Dragging (x + y) ──────────────────────────────────────
function startTitleDrag(e, currentX, currentY) {
  e.preventDefault();
  e.stopPropagation();
  const svg = document.getElementById('sankey-svg');
  const pt = svg.createSVGPoint();
  pt.x = e.clientX;
  pt.y = e.clientY;
  const svgP = pt.matrixTransform(svg.getScreenCTM().inverse());

  dragState = {
    isTitle: true,
    startMouseX: svgP.x,
    startMouseY: svgP.y,
    startOffsetX: titleDragOffset.x,
    startOffsetY: titleDragOffset.y
  };

  document.addEventListener('mousemove', onTitleDrag);
  document.addEventListener('mouseup', endTitleDrag);
}

function onTitleDrag(e) {
  if (!dragState || !dragState.isTitle) return;
  const svg = document.getElementById('sankey-svg');
  const pt = svg.createSVGPoint();
  pt.x = e.clientX;
  pt.y = e.clientY;
  const svgP = pt.matrixTransform(svg.getScreenCTM().inverse());

  titleDragOffset.x = dragState.startOffsetX + (svgP.x - dragState.startMouseX);
  titleDragOffset.y = dragState.startOffsetY + (svgP.y - dragState.startMouseY);
  renderDiagram();
}

function endTitleDrag() {
  dragState = null;
  document.removeEventListener('mousemove', onTitleDrag);
  document.removeEventListener('mouseup', endTitleDrag);
}

// ─── Zoom ─────────────────────────────────────────────────────────
function zoomIn() {
  zoomLevel = Math.min(zoomLevel * 1.3, 5);
  applyZoom();
}

function zoomOut() {
  zoomLevel = Math.max(zoomLevel / 1.3, 0.3);
  applyZoom();
}

function zoomReset() {
  zoomLevel = 1;
  const svg = document.getElementById('sankey-svg');
  const w = getStyleProp('canvas.width', 1200);
  const h = getStyleProp('canvas.height', 800);
  // Center the viewport on column 0
  if (lastCol0X != null) {
    const vbW = w;
    const vbH = h;
    const cx = lastCol0X;
    const cy = h / 2;
    svg.setAttribute('viewBox', `${cx - vbW / 2} ${cy - vbH / 2} ${vbW} ${vbH}`);
  } else {
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
  }
}

function applyZoom() {
  const svg = document.getElementById('sankey-svg');
  const w = getStyleProp('canvas.width', 1200);
  const h = getStyleProp('canvas.height', 800);
  const newW = w / zoomLevel;
  const newH = h / zoomLevel;
  const cx = lastCol0X ?? w / 2;
  const cy = h / 2;
  svg.setAttribute('viewBox', `${cx - newW/2} ${cy - newH/2} ${newW} ${newH}`);
}

// ─── Color preview in style tab ───────────────────────────────────
function updateColorPreview() {
  const container = document.getElementById('color-preview');
  if (!computedNodes.length) {
    container.innerHTML = '<div style="font-size:12px;color:var(--text-muted)">Render a diagram first</div>';
    return;
  }
  container.innerHTML = '';
  computedNodes.forEach(n => {
    const c = getNodeColor(n.id);
    const row = document.createElement('div');
    row.className = 'color-row';
    row.innerHTML = `<span class="color-swatch" style="background:${c}"></span><span>${n.id}</span><span style="color:var(--text-muted)">${c}</span>`;
    container.appendChild(row);
  });
}

// ─── Export ───────────────────────────────────────────────────────
function showExportModal() {
  document.getElementById('export-modal').classList.add('visible');
}

function closeExportModal() {
  document.getElementById('export-modal').classList.remove('visible');
}

function doExport() {
  const format = document.getElementById('export-format').value;
  const scale = parseInt(document.getElementById('export-scale').value);
  const includeData = document.getElementById('export-include-data').value === 'yes';

  const svgEl = document.getElementById('sankey-svg');
  const svgClone = svgEl.cloneNode(true);

  // Inline font imports for export
  const styleEl = document.createElementNS('http://www.w3.org/2000/svg', 'style');
  styleEl.textContent = `@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap');`;
  svgClone.insertBefore(styleEl, svgClone.firstChild);

  // Compute tight bounding box from node positions with label margin
  const labelMargin = 180;
  const pad = getStyleProp('canvas.padding', [50, 50, 50, 50]);
  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
  computedNodes.forEach(n => {
    minX = Math.min(minX, n.x - labelMargin);
    maxX = Math.max(maxX, n.x + getNodeWidth(n.id) + labelMargin);
    minY = Math.min(minY, n.y - pad[0]);
    maxY = Math.max(maxY, n.y + n.height + pad[2]);
  });
  // Include title area
  const titleText = getStyleProp('title.text', '');
  if (titleText) minY = Math.min(minY, pad[0] - 10);

  const exportX = minX;
  const exportY = minY;
  const exportW = maxX - minX;
  const exportH = maxY - minY;

  // Replace oversized bg rect with a tight one for export
  const bgRects = svgClone.querySelectorAll('rect');
  if (bgRects.length > 0 && bgRects[0].getAttribute('x') === '-5000') {
    const bg = getStyleProp('canvas.background', '#fafbfd');
    bgRects[0].setAttribute('x', exportX);
    bgRects[0].setAttribute('y', exportY);
    bgRects[0].setAttribute('width', exportW);
    bgRects[0].setAttribute('height', exportH);
  }

  svgClone.setAttribute('width', Math.round(exportW));
  svgClone.setAttribute('height', Math.round(exportH));
  svgClone.setAttribute('viewBox', `${exportX} ${exportY} ${exportW} ${exportH}`);

  // Include data as comment
  if (includeData) {
    const dataText = document.getElementById('data-editor').value;
    const styleText = document.getElementById('style-editor').value;
    const comment = document.createComment(`\n  SANKEY_DATA: ${dataText}\n  SANKEY_STYLE: ${styleText}\n  NODE_OFFSETS: ${JSON.stringify(nodeOffsets)}\n  TITLE_OFFSET: ${JSON.stringify(titleDragOffset)}\n  `);
    svgClone.appendChild(comment);
  }

  const svgStr = new XMLSerializer().serializeToString(svgClone);

  if (format === 'svg') {
    downloadBlob(new Blob([svgStr], { type: 'image/svg+xml' }), 'sankey-diagram.svg');
  } else {
    // PNG via canvas
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(exportW) * scale;
    canvas.height = Math.round(exportH) * scale;
    const ctx = canvas.getContext('2d');
    const img = new Image();
    img.onload = () => {
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

      if (includeData) {
        canvas.toBlob(blob => {
          downloadBlob(blob, 'sankey-diagram.png');
          const sidecar = `=== SANKEY DATA ===\n${document.getElementById('data-editor').value}\n\n=== SANKEY STYLE ===\n${document.getElementById('style-editor').value}\n\n=== NODE OFFSETS ===\n${JSON.stringify(nodeOffsets, null, 2)}\n\n=== TITLE OFFSET ===\n${JSON.stringify(titleDragOffset, null, 2)}`;
          downloadBlob(new Blob([sidecar], { type: 'text/plain' }), 'sankey-diagram-data.txt');
        }, 'image/png');
      } else {
        canvas.toBlob(blob => downloadBlob(blob, 'sankey-diagram.png'), 'image/png');
      }
    };
    img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgStr)));
  }

  closeExportModal();
  setStatus('Exported ' + format.toUpperCase());
}

function downloadBlob(blob, filename) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  a.click();
  URL.revokeObjectURL(a.href);
}

